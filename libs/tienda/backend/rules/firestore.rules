rules_version = '2';

// Reglas de Firestore de la Tienda CR. Fuente: docs/modelo-de-datos-firestore.md
// (§2 mapa de colecciones, §13 matriz rol × colección × operación, §14 presupuesto).
// Cada subcolección lleva su `match` anidado, porque la regla final lo deniega todo.
// Lo que escribe el backend (Admin SDK) no pasa por estas reglas: aquí no tiene `allow write`.
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Empleado y Permisos (ADR 0002) ──────────────────────────────────

    // Espejo de ROLE_PERMISSIONS en libs/tienda/shared/domain/src/permissions.ts;
    // role-permissions-mirror.spec.ts falla si dejan de ser iguales.
    // BEGIN ROLE_PERMISSIONS
    function rolePermissions() {
      return {
        'administrator': [
          'viewDraftsAndArchived',
          'editProducts',
          'publishProducts',
          'manageCategoriesAndTags',
          'recordStockMovements',
          'viewOrders',
          'advanceOrderStatus',
          'cancelOrReturnOrders',
          'viewCustomers',
          'disableCustomers',
          'handleDataRequests',
          'viewEmployees',
          'manageEmployees',
          'viewReports',
          'exportReports',
          'viewAuditLog',
          'manageSettings'
        ],
        'operator': [
          'viewDraftsAndArchived',
          'recordStockMovements',
          'viewOrders',
          'advanceOrderStatus',
          'cancelOrReturnOrders',
          'viewCustomers',
          'disableCustomers',
          'viewReports',
          'exportReports'
        ],
        'catalogEditor': [
          'viewDraftsAndArchived',
          'editProducts',
          'publishProducts',
          'manageCategoriesAndTags',
          'recordStockMovements',
          'viewReports',
          'exportReports'
        ]
      };
    }
    // END ROLE_PERMISSIONS

    // Documento de Empleado de la Cuenta (1 `get` por petición). Si no existe, el `get`
    // falla y la regla niega.
    function employee() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid)).data;
    }

    // Empleado Activo con correo verificado y un Rol de la tabla. Sin custom claims: se lee
    // su documento, así que deshabilitarlo corta la siguiente petición aunque el token siga vigente.
    function isActiveEmployee() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && employee().status == 'active'
        && employee().role in rolePermissions();
    }

    // ¿El Empleado Activo tiene el Permiso? Se pregunta por el Permiso, nunca por el Rol.
    function can(permission) {
      return isActiveEmployee() && permission in rolePermissions()[employee().role];
    }

    // ─── Escrituras del Panel directo (ADR 0005) ─────────────────────────

    // Toda escritura del Panel lleva su Autor y la hora del servidor: de ahí saca el Autor
    // el trigger de Bitácora. El backend nunca toca estos dos campos.
    function stamped() {
      return request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // Exactamente las claves del Modelo de datos: ni de más ni de menos.
    function keysAre(fields) {
      return request.resource.data.keys().hasOnly(fields)
        && request.resource.data.keys().hasAll(fields);
    }

    // Claves que cambian, sin los sellos que van en toda escritura.
    // `affectedKeys()` da un Set, así que se restan con `difference`, no con `removeAll`.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .difference(['updatedAt', 'updatedBy'].toSet());
    }

    // ─── Catálogo ────────────────────────────────────────────────────────

    // Presupuesto (§14). Peor caso previsto, el batch de renombrado que además mueve la
    // Categoría: la escritura del Producto lee `employees/{uid}`, `categories/{categoryId}`
    // y `slugs/{nuevo}`; cada escritura del índice lee `employees/{uid}` y `products/{id}`.
    // La escritura de una Variante lee `employees/{uid}` y `skus/{nuevo}`; cada escritura
    // del índice de SKU lee `employees/{uid}` y la Variante.
    // Ninguna evaluación pasa de 4 documentos distintos.

    function productFields() {
      return ['name', 'description', 'slug', 'categoryId', 'tagIds', 'status', 'publishedAt',
        'images', 'options', 'cabysCode', 'vatRateCode', 'unitOfMeasure', 'summary',
        'hasHistory', 'createdAt', 'updatedAt', 'updatedBy'];
    }

    // Forma del Producto: las claves del modelo, un estado conocido, los topes de §3.1 y el
    // invariante de la Imagen principal (`catalogIndex.mainImageId` sale de `images[0]`).
    function productShape() {
      let product = request.resource.data;
      return keysAre(productFields())
        && product.status in ['draft', 'published', 'archived']
        && product.images.size() <= 10
        && product.options.size() <= 3
        && (product.status != 'published' || product.images.size() >= 1);
    }

    // El resumen nace en ceros: de ahí en adelante lo mueve solo el backend (ADR 0006).
    function emptySummary() {
      let summary = request.resource.data.summary;
      return summary.size() == 4
        && summary.priceMin == 0 && summary.priceMax == 0
        && summary.inStock == false && summary.activeVariantCount == 0;
    }

    // Fecha de publicación: se fija al publicar por primera vez y no cambia después.
    function keepsPublishedAt() {
      return request.resource.data.publishedAt == (
        resource.data.status != 'published'
          && request.resource.data.status == 'published'
          && resource.data.publishedAt == null
        ? request.time
        : resource.data.publishedAt);
    }

    // El índice apunta al Producto al terminar el batch, y el Producto reclama ese slug.
    function slugPointsTo(slug, productId) {
      return getAfter(/databases/$(database)/documents/slugs/$(slug)).data.productId == productId;
    }

    function productAfter(productId) {
      return getAfter(/databases/$(database)/documents/products/$(productId)).data;
    }

    function productClaims(productId, slug) {
      return productAfter(productId).slug == slug;
    }

    function variantFields() {
      return ['sku', 'price', 'optionValues', 'weightGrams', 'active', 'imageId', 'stock',
        'hasHistory', 'createdAt', 'updatedAt', 'updatedBy'];
    }

    // Forma de la Variante: las claves del modelo y un SKU ya normalizado (mayúsculas, sin
    // espacios), porque el mismo string es el id de `skus/{sku}`. La regla no normaliza:
    // lo hace el Panel con `normalizeSku` de la librería compartida.
    function variantShape() {
      return keysAre(variantFields())
        && request.resource.data.sku.matches('^[A-Z0-9][A-Z0-9._-]*$');
    }

    // El índice apunta a la Variante al terminar el batch, y la Variante reclama ese SKU.
    function skuPointsTo(sku, productId, variantId) {
      let index = getAfter(/databases/$(database)/documents/skus/$(sku)).data;
      return index.productId == productId && index.variantId == variantId;
    }

    function variantAfter(productId, variantId) {
      return getAfter(
        /databases/$(database)/documents/products/$(productId)/variants/$(variantId)).data;
    }

    function variantClaims(productId, variantId, sku) {
      return variantAfter(productId, variantId).sku == sku;
    }

    function categoryExists(categoryId) {
      return exists(/databases/$(database)/documents/categories/$(categoryId));
    }

    function categoryFields() {
      return ['name', 'parentId', 'sortOrder', 'createdAt', 'updatedAt', 'updatedBy'];
    }

    // Árbol de dos niveles: si cuelga de alguien, el padre existe, es raíz y no es ella misma.
    function categoryShape(categoryId) {
      let parentId = request.resource.data.parentId;
      return keysAre(categoryFields())
        && (parentId == null
          || (parentId != categoryId
            && get(/databases/$(database)/documents/categories/$(parentId)).data.parentId == null));
    }

    function tagFields() {
      return ['name', 'createdAt', 'updatedAt', 'updatedBy'];
    }

    // Público: solo Productos Publicados, y la consulta debe filtrar `status == 'published'`.
    // Panel: todo estado, con "Ver Borradores y Archivados".
    match /products/{productId} {
      allow read: if resource.data.status == 'published' || can('viewDraftsAndArchived');

      // Nace Borrador: publicar es siempre una actualización posterior.
      allow create: if can('editProducts')
        && stamped()
        && productShape()
        && request.resource.data.status == 'draft'
        && request.resource.data.publishedAt == null
        && emptySummary()
        && request.resource.data.hasHistory == false
        && request.resource.data.createdAt == request.time
        && categoryExists(request.resource.data.categoryId)
        && slugPointsTo(request.resource.data.slug, productId);

      // Mover `status` pide "Publicar y archivar"; cualquier otro campo, "Crear y editar
      // Productos". Publicar toca además `publishedAt`, así que pide los dos Permisos: los
      // dos Roles que publican también editan.
      allow update: if (can('editProducts') || can('publishProducts'))
        && (!changed().hasAny(['status']) || can('publishProducts'))
        && (changed().difference(['status'].toSet()).size() == 0 || can('editProducts'))
        && stamped()
        && productShape()
        && !changed().hasAny(['summary', 'hasHistory', 'createdAt'])
        && keepsPublishedAt()
        && (!changed().hasAny(['slug']) || slugPointsTo(request.resource.data.slug, productId))
        && (!changed().hasAny(['categoryId']) || categoryExists(request.resource.data.categoryId));

      // Sin borrado: el Producto se archiva, y borrarlo es cosa de `deleteProduct`.

      // Público: solo si el Producto padre está Publicado (1 `get`).
      match /variants/{variantId} {
        allow read: if get(/databases/$(database)/documents/products/$(productId)).data.status == 'published'
          || can('viewDraftsAndArchived');

        // Nace en cero y sin historial: un "stock inicial" se registra como Entrada vía
        // callable (ADR 0003). Reclama su SKU en el mismo batch.
        allow create: if can('editProducts')
          && stamped()
          && variantShape()
          && request.resource.data.stock == 0
          && request.resource.data.hasHistory == false
          && request.resource.data.createdAt == request.time
          && skuPointsTo(request.resource.data.sku, productId, variantId);

        // `stock` y `hasHistory` los mueve solo el backend. El SKU se edita mientras la
        // Variante no tenga historial, y el índice nuevo va en el mismo batch (§3.2).
        allow update: if can('editProducts')
          && stamped()
          && variantShape()
          && !changed().hasAny(['stock', 'hasHistory', 'createdAt'])
          && (!changed().hasAny(['sku'])
            || (resource.data.hasHistory == false
              && skuPointsTo(request.resource.data.sku, productId, variantId)));

        // Sin borrado: borrar una Variante es cosa de `deleteVariant`.
      }
    }

    match /categories/{categoryId} {
      allow read: if true;

      allow create: if can('manageCategoriesAndTags')
        && stamped()
        && categoryShape(categoryId)
        && request.resource.data.createdAt == request.time;

      // Una raíz nunca baja a Subcategoría; una Subcategoría sí se mueve de raíz o sube.
      allow update: if can('manageCategoriesAndTags')
        && stamped()
        && categoryShape(categoryId)
        && !changed().hasAny(['createdAt'])
        && (request.resource.data.parentId == null || resource.data.parentId != null);
    }

    match /tags/{tagId} {
      allow read: if true;

      allow create: if can('manageCategoriesAndTags')
        && stamped()
        && keysAre(tagFields())
        && request.resource.data.createdAt == request.time;

      allow update: if can('manageCategoriesAndTags')
        && stamped()
        && keysAre(tagFields())
        && !changed().hasAny(['createdAt']);
    }

    // El Panel verifica la disponibilidad del SKU.
    match /skus/{sku} {
      allow read: if isActiveEmployee();

      // Se crea en el mismo batch que la Variante, solo si está libre (un `set` sobre uno
      // existente es `update`, y no hay `allow update`) y solo si la Variante lo reclama.
      allow create: if can('editProducts')
        && keysAre(['productId', 'variantId'])
        && variantClaims(request.resource.data.productId, request.resource.data.variantId, sku);

      // Como en `slugs`: solo el índice viejo de un renombrado, y solo si la Variante ya no
      // lo reclama y no tiene historial (§3.4, nota 5 de §13).
      allow delete: if can('editProducts')
        && !variantClaims(resource.data.productId, resource.data.variantId, sku)
        && variantAfter(resource.data.productId, resource.data.variantId).hasHistory == false;
    }

    match /slugs/{slug} {
      allow read: if true;

      // Se crea en el mismo batch que el Producto, solo si está libre (un `set` sobre uno
      // existente es `update`, y no hay `allow update`) y solo si el Producto lo reclama.
      allow create: if can('editProducts')
        && keysAre(['productId'])
        && productClaims(request.resource.data.productId, slug);

      // Única excepción a "sin borrados": el índice viejo de un renombrado, y solo si el
      // Producto ya no lo reclama y no tiene historial (§3.4, nota 5 de §13).
      allow delete: if can('editProducts')
        && !productClaims(resource.data.productId, slug)
        && productAfter(resource.data.productId).hasHistory == false;
    }

    match /catalogIndex/storefront {
      allow read: if true;
    }

    // ─── Stock ───────────────────────────────────────────────────────────

    match /stockMovements/{movementId} {
      allow read: if can('recordStockMovements');
    }

    match /stockImports/{importId} {
      allow read: if can('recordStockMovements');
    }

    // ─── Personas ────────────────────────────────────────────────────────

    // El propio documento se lee siempre, en cualquier estado: el Panel lo observa para
    // salir en cuanto deja de estar Activo. Todos, con "Ver Empleados".
    match /employees/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || can('viewEmployees');
    }

    match /invitations/{email} {
      allow read: if can('viewEmployees');
    }

    // Nombre del Autor de una acción, para cualquier Rol.
    match /staffDirectory/{uid} {
      allow read: if isActiveEmployee();
    }

    // Lectura del Panel; la del dueño llega con el ticket del Cliente.
    match /consents/{consentId} {
      allow read: if can('handleDataRequests');
    }

    match /dataRequests/{requestId} {
      allow read: if can('handleDataRequests');
    }

    // ─── Configuración ───────────────────────────────────────────────────

    // Toda la Configuración la escribe el Administrador ("Configuración") directo, y la audita
    // el trigger. La matriz §13 solo le da `U`, pero `settings/issuer` no tiene semilla: sin
    // `create` nadie podría llenarlo la primera vez desde el Panel, porque un `set` sobre un
    // documento que no existe es `create`. Se abren los dos, nunca el borrado.
    // Presupuesto (§14): la escritura de `settings/storefront` lee `employees/{uid}` y
    // `privacyNotices/{version}`; la del emisor, solo el Empleado.

    // Claves exactas de un mapa anidado: ni de más ni de menos, como `keysAre` con el documento.
    function mapKeysAre(value, fields) {
      return value.keys().hasOnly(fields) && value.keys().hasAll(fields);
    }

    function storefrontFields() {
      return ['shippingRates', 'shippingVatRateCode', 'paymentTimeouts', 'sinpeMovilNumber',
        'storeInfo', 'pickupInfo', 'currentPrivacyNoticeVersion', 'updatedAt', 'updatedBy'];
    }

    // El Aviso vigente tiene que existir: a su texto apunta la evidencia de Consentimiento.
    function privacyNoticeExists(version) {
      return exists(/databases/$(database)/documents/privacyNotices/$(version));
    }

    // Forma de §7.1: las claves del modelo, los mapas anidados con sus claves exactas y una
    // tarifa de envío por código de provincia (1–7).
    function storefrontShape() {
      let settings = request.resource.data;
      return keysAre(storefrontFields())
        && settings.shippingRates.keys().hasOnly(['1', '2', '3', '4', '5', '6', '7'])
        && mapKeysAre(settings.paymentTimeouts, ['cardMinutes', 'sinpeMovilMinutes'])
        && mapKeysAre(settings.storeInfo, ['name', 'contactEmail', 'contactPhone'])
        && mapKeysAre(settings.pickupInfo, ['address', 'hours'])
        && privacyNoticeExists(settings.currentPrivacyNoticeVersion);
    }

    function issuerFields() {
      return ['idType', 'idNumber', 'name', 'economicActivityCode', 'branch', 'terminal',
        'location', 'email', 'updatedAt', 'updatedBy'];
    }

    // Forma de §7.2: identificación de Hacienda (cédula física, jurídica, DIMEX o NITE),
    // sucursal de 3 dígitos, terminal de 5 y la ubicación con su código de distrito del
    // catálogo territorial. `idNumber` es texto: la jurídica admite alfanuméricos.
    function issuerShape() {
      let issuer = request.resource.data;
      return keysAre(issuerFields())
        && issuer.idType in ['01', '02', '03', '04']
        && issuer.branch.matches('^[0-9]{3}$')
        && issuer.terminal.matches('^[0-9]{5}$')
        && mapKeysAre(issuer.location,
          ['districtCode', 'provinceName', 'cantonName', 'districtName', 'otherSigns'])
        && issuer.location.districtCode.matches('^[0-9]{5}$')
        && issuer.location.otherSigns.size() >= 5
        && issuer.location.otherSigns.size() <= 160;
    }

    function privacyNoticeFields() {
      return ['text', 'purposes', 'publishedAt', 'updatedBy'];
    }

    // Finalidades del glosario: espejo de `Purpose` en la librería compartida.
    function purposeValues() {
      return ['accountAndOrders', 'marketing', 'panelAccess'];
    }

    match /settings/storefront {
      allow read: if true;

      allow create, update: if can('manageSettings')
        && stamped()
        && storefrontShape();
    }

    match /settings/issuer {
      allow read: if can('manageSettings');

      allow create, update: if can('manageSettings')
        && stamped()
        && issuerShape();
    }

    // Versión inmutable: se crea y nunca se edita ni se borra, así la evidencia de
    // Consentimiento apunta siempre al mismo texto; una versión nueva es un documento nuevo.
    // Su sello de hora es `publishedAt`, porque el Aviso no lleva `updatedAt` (§7.3).
    match /privacyNotices/{version} {
      allow read: if true;

      allow create: if can('manageSettings')
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.publishedAt == request.time
        && keysAre(privacyNoticeFields())
        && request.resource.data.purposes.hasOnly(purposeValues());
    }

    // ─── Reportes y Bitácora ─────────────────────────────────────────────

    match /salesDaily/{day} {
      allow read: if can('viewReports');
    }

    match /auditEvents/{eventId} {
      allow read: if can('viewAuditLog');
    }

    // ─── Notificaciones ──────────────────────────────────────────────────

    // Cada una la lee quien tiene el Permiso de su origen, y la consulta debe filtrar
    // `ref.collection`; quien tiene los tres Permisos (hoy, el Administrador) no filtra.
    match /notifications/{notificationId} {
      allow read: if (can('viewOrders') && can('viewEmployees') && can('handleDataRequests'))
        || (resource.data.ref.collection == 'orders' && can('viewOrders'))
        || (resource.data.ref.collection == 'invitations' && can('viewEmployees'))
        || (resource.data.ref.collection == 'dataRequests' && can('handleDataRequests'));
    }

    // ─── Regla final ─────────────────────────────────────────────────────

    // Todo lo que no aparece arriba queda denegado; `counters` no lo lee nadie.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
