rules_version = '2';

// Reglas de Storage de la Tienda CR. Por ahora todo queda denegado: la lectura
// pública de `products/**` y la subida desde el Panel llegan con su ticket
// (docs/modelo-de-datos-firestore.md §10).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
