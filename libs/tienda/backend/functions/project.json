{
  "name": "tienda-functions",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/tienda/backend/functions/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/lib"],
      "options": {
        "cwd": "libs/tienda/backend/functions",
        "command": "yarn build"
      }
    },
    "deploy-functions": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx firebase deploy --config firebase.tienda.json --project tienda --only functions"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/tienda/backend/functions/jest.config.ts",
        "tsConfig": "libs/tienda/backend/functions/tsconfig.spec.json"
      }
    },
    "test-functions": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node libs/tienda/backend/functions/tools/run-functions-tests.mjs"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
