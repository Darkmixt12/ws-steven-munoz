{
  "firestore": {
    "rules": "libs/tienda/backend/rules/firestore.rules",
    "indexes": "libs/tienda/backend/firestore.indexes.json"
  },
  "storage": {
    "rules": "libs/tienda/backend/rules/storage.rules"
  },
  "functions": [
    {
      "source": "libs/tienda/backend/functions",
      "codebase": "tienda",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true
    }
  }
}
